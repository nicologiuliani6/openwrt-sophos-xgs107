# Out-of-tree kernel build artifacts
driver/**/*.o
driver/**/*.ko
driver/**/*.mod
driver/**/*.mod.c
driver/**/.*.cmd
driver/**/Module.symvers
driver/**/modules.order
driver/**/.tmp_versions/

# Firmware blobs are redistributable but large; re-stage with scripts.
firmware-refs/mrvl/

# Hardware capture output
logs/*/
logs/*.txt

# Device dumps (proprietary Sophos/Marvell binaries) — never commit
dumps/

# Raw console captures stay local: they contain the unit's serial number,
# MACs and network config
logs/*.log

# Claude Code personal settings
.claude/settings.local.json
__pycache__/
