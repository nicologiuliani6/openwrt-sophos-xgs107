diff --git a/target/linux/x86/patches-6.18/952-ntb-netdev-name-ntbN.patch b/target/linux/x86/patches-6.18/952-ntb-netdev-name-ntbN.patch
new file mode 100644
index 0000000..99e6dde
--- /dev/null
+++ b/target/linux/x86/patches-6.18/952-ntb-netdev-name-ntbN.patch
@@ -0,0 +1,18 @@
+From: Nicolo Giuliani <nicologiuliani6@studio.unibo.it>
+Subject: [PATCH] net: ntb_netdev: name the interface ntbN
+
+A board with both an Ethernet MAC and NTB gets an "ethN" whose number
+depends on probe order; a stable ntbN name lets network configuration
+refer to the NTB link.
+
+---
+--- a/drivers/net/ntb_netdev.c
++++ b/drivers/net/ntb_netdev.c
+@@ -488,6 +488,7 @@
+ 	if (!ndev)
+ 		return -ENOMEM;
+ 
++	strscpy(ndev->name, "ntb%d", IFNAMSIZ);
+ 	SET_NETDEV_DEV(ndev, client_dev);
+ 
+ 	dev = netdev_priv(ndev);
diff --git a/target/linux/x86/patches-6.18/953-ntb-hw-epf-prefer-msi.patch b/target/linux/x86/patches-6.18/953-ntb-hw-epf-prefer-msi.patch
new file mode 100644
index 0000000..1436402
--- /dev/null
+++ b/target/linux/x86/patches-6.18/953-ntb-hw-epf-prefer-msi.patch
@@ -0,0 +1,35 @@
+From: Nicolo Giuliani <nicologiuliani6@studio.unibo.it>
+Subject: [PATCH] ntb: ntb_hw_epf: prefer MSI over MSI-X
+
+---
+--- a/drivers/ntb/hw/epf/ntb_hw_epf.c
++++ b/drivers/ntb/hw/epf/ntb_hw_epf.c
+@@ -366,16 +366,22 @@
+ 	int ret;
+ 	int i;
+ 
+-	irq = pci_alloc_irq_vectors(pdev, msi_min, msi_max, PCI_IRQ_MSIX);
+-	if (irq < 0) {
+-		dev_dbg(dev, "Failed to get MSIX interrupts\n");
++	/*
++	 * Prefer MSI: pci-epf-vntb raises MSI, and endpoint controllers whose
++	 * MSI-X capability is always present (DesignWare) would otherwise be
++	 * signalled through an MSI-X table that the function never fills in.
++	 */
++	irq = pci_alloc_irq_vectors(pdev, msi_min, msi_max, PCI_IRQ_MSI);
++	if (irq >= 0) {
++		argument &= ~MSIX_ENABLE;
++	} else {
++		dev_dbg(dev, "Failed to get MSI interrupts\n");
+ 		irq = pci_alloc_irq_vectors(pdev, msi_min, msi_max,
+-					    PCI_IRQ_MSI);
++					    PCI_IRQ_MSIX);
+ 		if (irq < 0) {
+-			dev_err(dev, "Failed to get MSI interrupts\n");
++			dev_err(dev, "Failed to get MSIX interrupts\n");
+ 			return irq;
+ 		}
+-		argument &= ~MSIX_ENABLE;
+ 	}
+ 
+ 	ndev->db_count = irq - 1;
