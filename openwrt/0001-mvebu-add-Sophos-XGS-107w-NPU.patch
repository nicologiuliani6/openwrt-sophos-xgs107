diff --git a/target/linux/mvebu/patches-6.18/950-net-dsa-mv88e6xxx-continue-without-PTP-clock.patch b/target/linux/mvebu/patches-6.18/950-net-dsa-mv88e6xxx-continue-without-PTP-clock.patch
new file mode 100644
index 0000000..1adaff6
--- /dev/null
+++ b/target/linux/mvebu/patches-6.18/950-net-dsa-mv88e6xxx-continue-without-PTP-clock.patch
@@ -0,0 +1,79 @@
+From: nicologiuliani6 <nicolo.giuliani6@studio.unibo.it>
+Subject: [PATCH] net: dsa: mv88e6xxx: continue without PTP if the TAI clock is unavailable
+
+On the 88E6193X in the Sophos XGS 107w the TAI clock period register reads
+0, so mv88e6xxx_cc_coeff_get() fails with -ENODEV and the whole switch
+probe is aborted. The switch is fully usable without PTP: disable
+hardware timestamping in that case instead of failing the probe, and
+make the timestamping entry points check that a PTP clock was actually
+registered.
+
+diff -ru a/drivers/net/dsa/mv88e6xxx/chip.c b/drivers/net/dsa/mv88e6xxx/chip.c
+--- a/drivers/net/dsa/mv88e6xxx/chip.c	2026-09-19 01:13:12.911513565 +0200
++++ b/drivers/net/dsa/mv88e6xxx/chip.c	2026-09-19 01:13:12.947860369 +0200
+@@ -4071,12 +4071,21 @@
+ 	/* Setup PTP Hardware Clock and timestamping */
+ 	if (chip->info->ptp_support) {
+ 		err = mv88e6xxx_ptp_setup(chip);
+-		if (err)
+-			goto unlock;
+-
+-		err = mv88e6xxx_hwtstamp_setup(chip);
+-		if (err)
++		if (err == -ENODEV) {
++			/* No usable TAI clock (e.g. its period reads as 0 on
++			 * some 88E6193X boards): run the switch without PTP
++			 * rather than failing the whole probe.
++			 */
++			dev_warn(chip->dev,
++				 "PTP clock unavailable, hardware timestamping disabled\n");
++			err = 0;
++		} else if (err) {
+ 			goto unlock;
++		} else {
++			err = mv88e6xxx_hwtstamp_setup(chip);
++			if (err)
++				goto unlock;
++		}
+ 	}
+ 
+ 	err = mv88e6xxx_stats_setup(chip);
+diff -ru a/drivers/net/dsa/mv88e6xxx/hwtstamp.c b/drivers/net/dsa/mv88e6xxx/hwtstamp.c
+--- a/drivers/net/dsa/mv88e6xxx/hwtstamp.c	2026-09-19 01:13:12.917563287 +0200
++++ b/drivers/net/dsa/mv88e6xxx/hwtstamp.c	2026-09-19 01:13:12.948487187 +0200
+@@ -72,7 +72,7 @@
+ 	chip = ds->priv;
+ 	ptp_ops = chip->info->ops->ptp_ops;
+ 
+-	if (!chip->info->ptp_support)
++	if (!chip->info->ptp_support || !chip->ptp_clock)
+ 		return -EOPNOTSUPP;
+ 
+ 	info->so_timestamping =
+@@ -176,7 +176,7 @@
+ 	struct mv88e6xxx_port_hwtstamp *ps = &chip->port_hwtstamp[port];
+ 	int err;
+ 
+-	if (!chip->info->ptp_support)
++	if (!chip->info->ptp_support || !chip->ptp_clock)
+ 		return -EOPNOTSUPP;
+ 
+ 	err = mv88e6xxx_set_hwtstamp_config(chip, port, config);
+@@ -195,7 +195,7 @@
+ 	struct mv88e6xxx_chip *chip = ds->priv;
+ 	struct mv88e6xxx_port_hwtstamp *ps = &chip->port_hwtstamp[port];
+ 
+-	if (!chip->info->ptp_support)
++	if (!chip->info->ptp_support || !chip->ptp_clock)
+ 		return -EOPNOTSUPP;
+ 
+ 	*config = ps->tstamp_config;
+@@ -213,7 +213,7 @@
+ 	struct mv88e6xxx_port_hwtstamp *ps = &chip->port_hwtstamp[port];
+ 	struct ptp_header *hdr;
+ 
+-	if (!chip->info->ptp_support)
++	if (!chip->info->ptp_support || !chip->ptp_clock)
+ 		return NULL;
+ 
+ 	hdr = ptp_parse_header(skb, type);
diff --git a/target/linux/mvebu/patches-6.18/951-PCI-dwc-plat-ep-1M-BAR-align.patch b/target/linux/mvebu/patches-6.18/951-PCI-dwc-plat-ep-1M-BAR-align.patch
new file mode 100644
index 0000000..a755cbf
--- /dev/null
+++ b/target/linux/mvebu/patches-6.18/951-PCI-dwc-plat-ep-1M-BAR-align.patch
@@ -0,0 +1,45 @@
+From: Nicolo Giuliani <nicologiuliani6@studio.unibo.it>
+Subject: [PATCH] PCI: dwc: plat: endpoint mode on Armada 8K / CN913x
+
+- advertise 1M BAR alignment: the BAR match iATU on this core ignores the
+  low 20 bits of the target (the BARs are 1M), so a BAR backed by memory
+  that is only page or 64K aligned makes the host read and write a
+  different place than the endpoint function thinks (vNTB's control BAR)
+- disable the iATU windows the boot firmware left enabled
+
+---
+--- a/drivers/pci/controller/dwc/pcie-designware-plat.c
++++ b/drivers/pci/controller/dwc/pcie-designware-plat.c
+@@ -10,6 +10,7 @@
+ #include <linux/delay.h>
+ #include <linux/gpio.h>
+ #include <linux/interrupt.h>
++#include <linux/io.h>
+ #include <linux/kernel.h>
+ #include <linux/init.h>
+ #include <linux/of.h>
+@@ -36,9 +37,16 @@
+ {
+ 	struct dw_pcie *pci = to_dw_pcie_from_ep(ep);
+ 	enum pci_barno bar;
++	u32 i;
+ 
+ 	for (bar = 0; bar < PCI_STD_NUM_BARS; bar++)
+ 		dw_pcie_ep_reset_bar(pci, bar);
++
++	/* drop the iATU windows the boot firmware left behind */
++	for (i = 0; i < pci->num_ib_windows; i++)
++		dw_pcie_disable_atu(pci, PCIE_ATU_REGION_DIR_IB, i);
++	for (i = 0; i < pci->num_ob_windows; i++)
++		dw_pcie_disable_atu(pci, PCIE_ATU_REGION_DIR_OB, i);
+ }
+ 
+ static int dw_plat_pcie_ep_raise_irq(struct dw_pcie_ep *ep, u8 func_no,
+@@ -63,6 +71,7 @@
+ static const struct pci_epc_features dw_plat_pcie_epc_features = {
+ 	.msi_capable = true,
+ 	.msix_capable = true,
++	.align = SZ_1M,
+ };
+ 
+ static const struct pci_epc_features*
diff --git a/target/linux/mvebu/patches-6.18/952-ntb-netdev-name-ntbN.patch b/target/linux/mvebu/patches-6.18/952-ntb-netdev-name-ntbN.patch
new file mode 100644
index 0000000..99e6dde
--- /dev/null
+++ b/target/linux/mvebu/patches-6.18/952-ntb-netdev-name-ntbN.patch
@@ -0,0 +1,18 @@
+From: Nicolo Giuliani <nicologiuliani6@studio.unibo.it>
+Subject: [PATCH] net: ntb_netdev: name the interface ntbN
+
+A board with both an Ethernet MAC and NTB gets an "ethN" whose number
+depends on probe order; a stable ntbN name lets network configuration
+refer to the NTB link.
+
+---
+--- a/drivers/net/ntb_netdev.c
++++ b/drivers/net/ntb_netdev.c
+@@ -488,6 +488,7 @@
+ 	if (!ndev)
+ 		return -ENOMEM;
+ 
++	strscpy(ndev->name, "ntb%d", IFNAMSIZ);
+ 	SET_NETDEV_DEV(ndev, client_dev);
+ 
+ 	dev = netdev_priv(ndev);
