From: Nicolo Giuliani <nicologiuliani6@studio.unibo.it>
Subject: [PATCH] PCI: dwc: plat: endpoint fixes for Armada 8K / CN913x

- advertise 64K BAR alignment: the DesignWare inbound iATU needs the target
  address aligned to its region alignment, and without .align the EPF core
  allocates small BARs (the vNTB control BAR) with page alignment, failing
  dw_pcie_prog_ep_inbound_atu() with -EINVAL
- program the AXI cache and shareability attributes of the PCIe master from
  the optional "vendor" register range, as pcie-armada8k.c does in RC mode

---
--- a/drivers/pci/controller/dwc/pcie-designware-plat.c
+++ b/drivers/pci/controller/dwc/pcie-designware-plat.c
@@ -10,6 +10,7 @@
 #include <linux/delay.h>
 #include <linux/gpio.h>
 #include <linux/interrupt.h>
+#include <linux/io.h>
 #include <linux/kernel.h>
 #include <linux/init.h>
 #include <linux/of.h>
@@ -39,6 +40,29 @@
 
 	for (bar = 0; bar < PCI_STD_NUM_BARS; bar++)
 		dw_pcie_ep_reset_bar(pci, bar);
+
+	/*
+	 * Armada 8K / CN913x: AXI cache and domain attributes of the PCIe
+	 * master live in the vendor registers next to the DBI; the RC driver
+	 * sets them, in endpoint mode nobody does.
+	 */
+	{
+		struct platform_device *pdev = to_platform_device(pci->dev);
+		void __iomem *v = devm_platform_ioremap_resource_byname(pdev, "vendor");
+		u32 r;
+
+		if (!IS_ERR(v)) {
+			dev_info(pci->dev, "vendor regs: ctl %08x sts %08x arc %08x awc %08x aru %08x awu %08x\n",
+				 readl(v), readl(v + 8), readl(v + 0x50), readl(v + 0x54),
+				 readl(v + 0x5c), readl(v + 0x60));
+			writel(0x3511, v + 0x50);
+			writel(0x5311, v + 0x54);
+			r = readl(v + 0x5c);
+			writel((r & ~(3 << 4)) | (2 << 4), v + 0x5c);
+			r = readl(v + 0x60);
+			writel((r & ~(3 << 4)) | (2 << 4), v + 0x60);
+		}
+	}
 }
 
 static int dw_plat_pcie_ep_raise_irq(struct dw_pcie_ep *ep, u8 func_no,
@@ -63,6 +87,7 @@
 static const struct pci_epc_features dw_plat_pcie_epc_features = {
 	.msi_capable = true,
 	.msix_capable = true,
+	.align = SZ_64K,
 };
 
 static const struct pci_epc_features*
